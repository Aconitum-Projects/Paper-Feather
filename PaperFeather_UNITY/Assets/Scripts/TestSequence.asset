%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd8a9d01d7406874dba4906e1b3b069c, type: 3}
  m_Name: TestSequence
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Prototype
    text: Salut <color=#FFE282>Giu</color> !
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: Tu test les dialogues ?
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: "Ca \xE0 l'air de marcher !"
    speakerSprite: {fileID: 21300000, guid: 44570286747c43e4291d8cef3eb2972b, type: 3}
    hasChoices: 1
    choices:
    - choiceText: "T'es s\xFBr ?"
      branchLines:
      - speakerName: Prototype
        text: "Comment \xE7a, je suis s\xFBr ?"
        speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
        hasChoices: 0
        choices: []
      - speakerName: Prototype
        text: "Bien entendu que je suis s\xFBr !"
        speakerSprite: {fileID: 21300000, guid: 44570286747c43e4291d8cef3eb2972b, type: 3}
        hasChoices: 0
        choices: []
    - choiceText: On dirait bien !
      branchLines:
      - speakerName: Prototype
        text: "C'est \xE7a qu'on veut !"
        speakerSprite: {fileID: 21300000, guid: 44570286747c43e4291d8cef3eb2972b, type: 3}
        hasChoices: 0
        choices: []
    - choiceText: Je test, c'est pas fini.
      branchLines:
      - speakerName: Prototype
        text: Je sais bien, enfin !
        speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
        hasChoices: 0
        choices: []
      - speakerName: Prototype
        text: "Mais t'inqui\xE8tes, \xE7a va aller !"
        speakerSprite: {fileID: 21300000, guid: 44570286747c43e4291d8cef3eb2972b, type: 3}
        hasChoices: 0
        choices: []
  - speakerName: Prototype
    text: Bon, les choix focntionnent, non ?
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: En tout cas, t'en auras fais beaucoup.
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: "Pense \xE0 mettre la logique de disparition de dialogue!"
    speakerSprite: {fileID: 21300000, guid: 44570286747c43e4291d8cef3eb2972b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: On va tester quelques trucs avec TMP.
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Couleur : <color=#FFE282>On va tester quelques trucs avec TMP.</color>'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Gras : <b>On va tester quelques trucs avec TMP.</b>'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Italique : <i>On va tester quelques trucs avec TMP.</i>'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Taille : <size=300%>On va tester quelques trucs avec TMP.</size>'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Saut de ligne : <br>On va tester quelques trucs avec TMP. \nOn va tester
      quelques trucs avec TMP.'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: 'Espace : <space=100>On va tester quelques trucs avec TMP.'
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: "Soulign\xE9 : <u>On va tester quelques trucs avec TMP.</u>"
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
  - speakerName: Prototype
    text: "Barr\xE9 : <s>On va tester quelques trucs avec TMP.</s>"
    speakerSprite: {fileID: 21300000, guid: 739bd777d72c06f4d9c5d1f7a3bdf84b, type: 3}
    hasChoices: 0
    choices: []
